{
    "name": "@sahelpay/sdk",
    "version": "1.1.0",
    "description": "SDK officiel SahelPay pour JavaScript/TypeScript - Paiements Mobile Money en Afrique de l'Ouest",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./merchant": {
            "types": "./dist/merchant.d.ts",
            "import": "./dist/merchant.mjs",
            "require": "./dist/merchant.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/merchant.ts --format cjs,esm --dts --cjsInterop",
        "dev": "tsup src/index.ts src/merchant.ts --format cjs,esm --dts --cjsInterop --watch",
        "test": "npm run build && vitest run",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit -p ."
    },
    "keywords": [
        "sahelpay",
        "payment",
        "mobile-money",
        "orange-money",
        "wave",
        "moov",
        "mali",
        "senegal",
        "africa",
        "fintech",
        "api",
        "sdk"
    ],
    "author": "SahelPay <dev@sahelpay.ml>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dione24/sahelpay-sdks.git",
        "directory": "javascript"
    },
    "homepage": "https://docs.sahelpay.ml/sdks/javascript",
    "bugs": {
        "url": "https://github.com/dione24/sahelpay-sdks/issues"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "tsup": "^8.5.1",
        "typescript": "^5.3.0",
        "vitest": "^5.0.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
