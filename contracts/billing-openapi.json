                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,160}$",
                    "description": "Référence stable de l’unité facturée, propre à l’application et au mode. Rejeu identique = même abonnement ; paramètres différents = 409."
                  },
                  "plan_id": {
                    "type": "string"
                  },
                  "customer_external_ref": {
                    "type": "string",
                    "description": "Référence externe unique dans cette application"
                  },
                  "customer_email": {
                    "type": "string",
