                  },
                  {
                    "required": [
                      "customer_email"
                    ]
                  }
                ],
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Identifiant client de cette application"
                  },
                  "customer_phone": {
                    "type": "string",
                    "description": "Téléphone facultatif si une autre identité est fournie"
                  },
                  "customer_external_ref": {
                    "type": "string",
                    "description": "Référence externe unique dans cette application"
                  },
                  "customer_email": {
                    "type": "string",
                    "format": "email"
                  },
                  "customer_name": {
                    "type": "string"
                  },
                  "plan_id": {
                    "type": "string"
                  },
                  "trial_end": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "external_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,160}$",
                    "description": "Référence stable de checkout par application et mode. Nécessite customer_external_ref et une clé API d’application ; reprise identique = même abonnement et première facture, conflit des paramètres = 409."
                  },
                  "redirect_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          },
          "409": {
            "description": "INVOICE_PAYMENT_SETTLEMENT_PENDING : un paiement a déjà réussi pour cette facture, son reçu est en cours de reprise. Ne pas payer à nouveau ; relire le paiement et la facture."
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Create subscription with immediate payment link",
        "tags": [
          "Merchant"
        ]
      }
    },
    "/v1/billing/subscriptions/{id}": {
      "get": {
        "operationId": "getSubscription",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "external_ref",
                        "livemode",
                        "application_id",
                        "customer",
                        "plan_id",
                        "plan",
                        "status",
                        "updated_at",
                        "current_period_start",
                        "current_period_end",
                        "trial_end",
                        "next_billing_date",
                        "past_due_since",
                        "payment_url",
                        "invoice_id",
                        "grace_until",
                        "billing_anchor_at",
                        "access_status"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "external_ref": {
                          "type": "string",
                          "nullable": true
                        },
                        "livemode": {
                          "type": "boolean",
                          "nullable": true
                        },
                        "application_id": {
                          "type": "string",
                          "nullable": true
                        },
                        "customer": {
                          "type": "object",
                          "nullable": true,
                          "required": [
                            "id",
                            "external_ref",
                            "email"
                          ],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "external_ref": {
                              "type": "string",
                              "nullable": true
                            },
                            "email": {
                              "type": "string",
                              "nullable": true,
                              "format": "email"
                            }
                          }
                        },
                        "plan_id": {
                          "type": "string"
                        },
                        "plan": {
                          "type": "object",
                          "required": [
                            "amount",
                            "currency",
                            "interval"
                          ],
                          "properties": {
                            "amount": {
                              "type": "number"
                            },
                            "currency": {
                              "type": "string",
                              "enum": [
                                "XOF"
                              ]
                            },
                            "interval": {
                              "type": "string",
                              "enum": [
                                "WEEKLY",
                                "MONTHLY",
                                "QUARTERLY",
                                "YEARLY"
                              ]
                            }
                          }
                        },
                        "status": {
                          "type": "string",
                          "description": "Collecte : ACTIVE = période payée courante, TRIALING = essai courant. Une échéance impayée reste PAST_DUE et payable même après fin des droits. CANCELLED prévaut. Lire access_status et les bornes pour les droits.",
                          "enum": [
                            "ACTIVE",
                            "TRIALING",
                            "PAST_DUE",
                            "CANCELLED",
                            "INCOMPLETE"
                          ]
                        },
                        "access_status": {
                          "type": "string",
                          "description": "Droits : EXPIRED à period_end + 3 jours après période payée ; essai terminé = EXPIRED sans grâce. Champ additif ; les consommateurs historiques calculent la même frontière depuis les dates.",
                          "enum": [
                            "ACTIVE",
                            "TRIALING",
                            "PAST_DUE",
                            "EXPIRED",
                            "CANCELLED",
                            "INCOMPLETE"
                          ]
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Version de l’abonnement, indépendante de la livraison du webhook."
                        },
                        "current_period_start": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "current_period_end": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "trial_end": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "next_billing_date": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "past_due_since": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "grace_until": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true,
                          "description": "Fin de grâce d’une période payée, ancrée à current_period_end + 3 jours ; null pour essai, INCOMPLETE ou CANCELLED."
                        },
                        "billing_anchor_at": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Ancre UTC conservée pendant les renouvellements à l’heure ; redémarre au paiement initial ou après la grâce."
                        },
                        "payment_url": {
                          "type": "string",
                          "nullable": true,
                          "format": "uri"
                        },
                        "invoice_id": {
                          "type": "string",
                          "nullable": true
                        }
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Read the canonical subscription, period and current invoice link",
        "tags": [
          "Merchant"
        ]
      },
      "delete": {
        "description": "Annulation immédiate CANCELLED, sans prorata ni remboursement automatique. Émet subscription.cancelled comme signal de GET canonique. Rejeu : même event.id, sans changer updated_at ; un paiement tardif règle la facture sans réactiver un abonnement annulé. Pas d’annulation programmée à fin de période.",
        "operationId": "cancelSubscription",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Cancel a subscription",
        "tags": [
          "Merchant"
        ]
      }
    },
