    "/v1/billing/subscriptions": {
      "get": {
        "operationId": "listSubscriptions",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "État de collecte comme le GET canonique ; access_status indique EXPIRED après la grâce.",
            "schema": {
              "enum": [
                "ACTIVE",
                "TRIALING",
                "PAST_DUE",
                "CANCELLED",
                "INCOMPLETE"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "List customer subscriptions",
        "tags": [
          "Merchant"
        ]
      },
      "post": {
        "description": "Abonnement de vos clients, distinct de votre accès marchand à SahelPay. Création INCOMPLETE sans paiement, ou essai explicite identifié par trial_end (GET canonique TRIALING). Le worker horaire prépare la facture à start_date, ou à trial_end. ACTIVE canonique signifie une période payée courante ; access_status passe de PAST_DUE à EXPIRED après trois jours de grâce payée. status reste PAST_DUE pour permettre de régler la même facture après expiration des droits. Un essai terminé n’a aucune grâce. Aucun prélèvement automatique. X-Idempotency-Key n’est pas encore garanti par cette route.",
        "operationId": "createSubscription",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "plan_id"
                ],
                "anyOf": [
                  {
                    "required": [
                      "customer_id"
                    ]
                  },
                  {
                    "required": [
                      "customer_phone"
                    ]
                  },
                  {
                    "required": [
                      "customer_external_ref"
                    ]
                  },
                  {
                    "required": [
                      "customer_email"
                    ]
                  }
                ],
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Identifiant client de cette application"
                  },
                  "customer_phone": {
                    "type": "string",
                    "description": "Téléphone facultatif si une autre identité est fournie"
                  },
                  "customer_external_ref": {
                    "type": "string",
                    "description": "Référence externe unique dans cette application"
                  },
                  "customer_email": {
                    "type": "string",
                    "format": "email"
                  },
                  "customer_name": {
                    "type": "string"
                  },
                  "plan_id": {
                    "type": "string"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "trial_end": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Create a subscription for a customer",
        "tags": [
          "Merchant"
        ]
      }
    },
    "/v1/billing/subscriptions/with-payment": {
      "post": {
        "description": "Creates a subscription and generates a payment link in one request. Dev-friendly for SaaS integrations.",
        "operationId": "createSubscriptionWithPayment",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "plan_id"
                ],
                "anyOf": [
                  {
                    "required": [
                      "customer_id"
