{
    "name": "sahelpay/sahelpay-php",
    "description": "SDK PHP officiel pour l'API SahelPay - Solutions de paiement Mobile Money pour l'Afrique de l'Ouest",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sahelpay",
        "mobile money",
        "payment",
        "orange money",
        "wave",
        "moov",
        "mali",
        "senegal",
        "africa",
        "fintech"
    ],
    "authors": [
        {
            "name": "SahelPay",
            "email": "dev@sahelpay.ml"
        }
    ],
    "homepage": "https://sahelpay.ml",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "SahelPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SahelPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SahelPay\\Laravel\\SahelPayServiceProvider"
            ],
            "aliases": {
                "SahelPay": "SahelPay\\Laravel\\Facades\\SahelPay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "email": "dev@sahelpay.ml",
        "docs": "https://docs.sahelpay.ml",
        "issues": "https://github.com/dione24/sahelpay-sdks/issues",
        "source": "https://github.com/dione24/sahelpay-sdks"
    },
    "scripts": {
        "test": "phpunit --testsuite Unit --no-coverage"
    },
    "config": {
        "sort-packages": true
    }
}
